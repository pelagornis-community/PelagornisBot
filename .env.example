# PelagornisBot Lite
# cp .env.example .env 후 값 채우기 ( .env 는 git에 올리지 마세요 )

# [필수] Developer Portal → Bot → Reset Token / View Token
DISCORD_BOT_TOKEN=

# [권장] Developer Portal → General Information → APPLICATION ID
# (= 애플리케이션 ID, slash 등록·문서용 — 현재 Go 봇은 부팅에 필수는 아님)
DISCORD_CLIENT_ID=

# [권장] 개발용 Discord 서버 ID — 슬래시 명령이 즉시 반영됨 (우클릭 서버 → ID 복사, 개발자 모드 ON)
DISCORD_GUILD_ID=

# [선택] General Information → PUBLIC KEY — HTTP Interactions 검증용
# Gateway 봇(discordgo)만 쓸 때는 비워도 됨
# DISCORD_PUBLIC_KEY=

# config 경로 (기본: config/config.yaml)
# CONFIG_PATH=config/config.yaml

# data 디렉터리 (기본: data)
# DATA_DIR=data
